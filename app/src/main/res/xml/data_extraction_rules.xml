<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for API 31+. Editable source copies are large and device-specific. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="editable/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="editable/" />
    </device-transfer>
</data-extraction-rules>
